{
  "expo": {
    "name": "Ejemplo3Camara",
    "slug": "ejemplo3camara",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.ejemplo.ejemplo3camara",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para tomar fotos dentro de la app.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
